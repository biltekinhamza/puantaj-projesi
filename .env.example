# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
POSTGRES_DB=puantaj
POSTGRES_USER=puantaj
POSTGRES_PASSWORD=puantaj_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superuser (auto-created on first run)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin12345
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Auto import personnel from JSON
AUTO_IMPORT_PERSONEL=1